# Copy this file to .env and adjust if needed.
DATABASE_URL=postgresql://sentry:sentry@localhost:5432/sentry
CORS_ORIGINS=*

# Admin API key — required to call PATCH /roads/{id}/status and
# POST /risk/recompute. Generate one yourself, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset (or blank) and those endpoints will refuse to work
# rather than silently staying open.
ADMIN_API_KEY=

# Background risk-recompute loop (see app/scheduler.py)
RISK_RECOMPUTE_ENABLED=true
RISK_RECOMPUTE_INTERVAL_SECONDS=300

# Real IMD weather data ingestion (see app/ingestion/). Requires your
# server's IP whitelisted with IMD (https://api.imd.gov.in/public/index.php)
# and real station/district IDs set in app/ingestion/zone_mapping.py.
# Stays disabled by default so it doesn't fail loudly on every interval
# before you've set those up.
IMD_BASE_URL=https://api.imd.gov.in/api/v1
IMD_INGEST_ENABLED=false
IMD_INGEST_INTERVAL_SECONDS=1800
